# libFuzzer dictionary for sfnt / OpenType input.
# Without these tokens it is very unlikely that random mutation produces a
# valid table directory, so coverage would stay stuck at the header check.
magic_sfnt="\x00\x01\x00\x00"
magic_otto="OTTO"
magic_ttcf="ttcf"
magic_true="true"
magic_typ1="typ1"
magic_woff="wOFF"
magic_woff2="wOF2"
