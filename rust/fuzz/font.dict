tag_maxp="maxp"
tag_hmtx="hmtx"
tag_cmap="cmap"
tag_glyf="glyf"
tag_loca="loca"
tag_name="name"
tag_post="post"
tag_os2="OS/2"
tag_fvar="fvar"
tag_gvar="gvar"
tag_avar="avar"
tag_hvar="HVAR"
tag_mvar="MVAR"
tag_stat="STAT"
tag_gsub="GSUB"
tag_gpos="GPOS"
tag_gdef="GDEF"
tag_cpal="CPAL"
tag_colr="COLR"
tag_cbdt="CBDT"
tag_sbix="sbix"
tag_math="MATH"
tag_varc="VARC"
